# Vue2 集成环境示例。复制为 .env.local 后按平台网关调整，真实密钥不要提交。
# 后端域名；留空表示同源或本地 Vite proxy。
VITE_API_BASE_URL=

# 接口路径前缀；本仓库 .NET 后端默认 /api；若你们平台网关已去掉 /api，可设为空字符串。
VITE_API_PATH_PREFIX=/api

# 如平台要求 API Key，在本地或部署环境注入。不要硬编码到 src/api/client.ts。
VITE_API_KEY=

# history 适合独立部署；hash 适合嵌入到 Vue2 老平台或静态目录，避免服务端路由兜底问题。
VITE_ROUTER_MODE=history
